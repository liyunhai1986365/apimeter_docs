# Copy this file to scripts/deploy.target.env and fill in the target host.
# Do not commit scripts/deploy.target.env.

# Required
DEPLOY_HOST=

# SSH connection
DEPLOY_PORT=22
DEPLOY_USER=root
# Prefer DEPLOY_SSH_KEY for unattended deploys. Leave DEPLOY_PASSWORD empty when using a key.
DEPLOY_SSH_KEY=
DEPLOY_PASSWORD=

# Remote runtime
DEPLOY_REMOTE_DIR=/www/wwwroot/modelsell-docs
DEPLOY_SERVICE_NAME=modelsell-docs
DEPLOY_APP_PORT=3030

